GO_API_URL=http://127.0.0.1:8080
PACTRA_APP_ORIGIN=http://localhost:3000
PACTRA_PUBLIC_INDEXING=false
# Advisory AI surfaces only when exactly "true"; deterministic checks always work.
PACTRA_PUBLIC_AI_ENABLED=false
# Production: APP_ORIGIN must be https, and GO_API_URL must be https unless a
# numeric loopback. next start bakes code at build time; .env values are read
# at startup (dev) or process env (prod server).

# Leave network fields empty until the team verifies the intended chain.
# These are PUBLIC network metadata, never secret RPC credentials.
PACTRA_CHAIN_ID=
PACTRA_CHAIN_NAME=
PACTRA_RPC_URL=
PACTRA_EXPLORER_URL=
# Public escrow contract address for the configured chain; powers the
# landing BOT Chain badge link to the official explorer.
PACTRA_ESCROW_ADDRESS=
PACTRA_NATIVE_CURRENCY_NAME=
PACTRA_NATIVE_CURRENCY_SYMBOL=
PACTRA_NATIVE_CURRENCY_DECIMALS=

# Optional; without it only installed/injected wallets are offered.
PACTRA_WALLETCONNECT_PROJECT_ID=

# Must match Go's team-approved allowlist. Empty disables task creation.
PACTRA_ARBITERS=
