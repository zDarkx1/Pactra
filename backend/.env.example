HOST=127.0.0.1
PORT=8080
# All workspace fields empty => stateless checker mode.
# Remote DB requires sslmode=verify-full and a trusted CA.
DATABASE_URL=
PACTRA_AUTH_DOMAIN=
PACTRA_AUTH_URI=
PACTRA_CHAIN_ID=
# Comma-separated team-approved EOA arbiter wallets; empty disables task creation.
PACTRA_ARBITERS=
# Optional Azure advisory review. Keep these on the Go server, never NEXT_PUBLIC_.
PACTRA_AI_ENDPOINT=
PACTRA_AI_MODEL=
PACTRA_AI_KEY=
# Optional read-only chain reconciliation; off unless explicitly true.
# Do not expose RPC credentials or attestor material to frontend/BFF responses.
PACTRA_ONCHAIN_ENABLED=false
PACTRA_ONCHAIN_RPC_URL=
PACTRA_ONCHAIN_ESCROW=
PACTRA_ONCHAIN_CONFIRMATIONS=1
# Private regular file (0600/0400) containing a dedicated unfunded EOA secret.
# Missing signer keeps availability route closed; never use real arbiter keys.
PACTRA_ONCHAIN_ATTESTOR_KEY_FILE=
# Tests only: isolated disposable database, never hosted production.
# TEST_DATABASE_URL uses NEW pactra_settlement_backend on local port 5546.
