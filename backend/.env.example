HOST=127.0.0.1
PORT=8080
# All workspace fields empty => stateless checker mode.
# Remote DB requires sslmode=verify-full and a trusted CA.
DATABASE_URL=
PACTRA_AUTH_DOMAIN=
PACTRA_AUTH_URI=
PACTRA_CHAIN_ID=
# Comma-separated team-approved EOA arbiter wallets; empty disables task creation.
PACTRA_ARBITERS=
# Optional Azure advisory review. Keep these on the Go server, never NEXT_PUBLIC_.
PACTRA_AI_ENDPOINT=
PACTRA_AI_MODEL=
PACTRA_AI_KEY=
# Tests only: isolated disposable database, never hosted production.
# TEST_DATABASE_URL=postgres://test:test@localhost:5432/pactra_test?sslmode=disable
